# Personal Second Brain - Environment Configuration（开源精简版）
# 说明：docker compose 已内置全部默认值，无需复制本文件即可启动。
# 注意：compose 仅对以下变量做 ${VAR:-default} 插值：ALLOWED_ORIGINS、SECRET_KEY、
# ADMIN_SECRET_KEY、DATABASE_ENCRYPT_KEY、MINIO_ROOT_USER、MINIO_ROOT_PASSWORD、
# GRAPHIFY_OLLAMA_MODEL。在根目录自建 .env 只能覆盖这些变量；其余变量需直接修改
# docker-compose.yml，或在 backend 工作目录放置 .env（供 uvicorn 本地开发使用）。

# Application
ENV=development
APP_NAME=Personal Second Brain

# Database
DATABASE_URL=sqlite:///./psb.db
# 生产环境必须设置；开发环境留空则关闭数据库加密。
DATABASE_ENCRYPT_KEY=

# Security (生产环境必须设置强随机密钥!)
# 开发环境留空会自动生成临时密钥，但生产环境启动会失败。
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Admin (生产环境必须设置强随机密钥!)
ADMIN_SECRET_KEY=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local LLM (Ollama，开源版仅支持本地模型)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
# 图谱构建（graphify）专用模型，空则回退 OLLAMA_MODEL；
# 0.5B 模型无法稳定输出提取 JSON，想用好图谱建议 qwen2.5:3b 或 qwen2.5-coder:7b（需先 ollama pull）
GRAPHIFY_OLLAMA_MODEL=

# Model routing configs
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS_DEFAULT=2048
MAX_TOKENS_LONG=8192

# Embeddings
CHROMADB_PERSIST_DIR=./chroma_db
EMBEDDING_DIMENSION=768

# URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost

# Object storage (S3-compatible, default points to local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=psbminio
S3_SECRET_KEY=psbminio-secret
S3_BUCKET=psb-sync
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true

# CORS
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 网盘接入（可选，留空则关闭对应网盘功能）
BAIDU_NETDISK_CLIENT_ID=
BAIDU_NETDISK_CLIENT_SECRET=
# 留空则默认 {API_BASE_URL}/api/v1/storage/drives/baidu/callback
BAIDU_NETDISK_REDIRECT_URI=
ALIYUN_NETDISK_CLIENT_ID=
ALIYUN_NETDISK_CLIENT_SECRET=
# 留空则默认 {API_BASE_URL}/api/v1/storage/drives/aliyun/callback
ALIYUN_NETDISK_REDIRECT_URI=

# 静态托管前端构建产物（可选）：指向已构建的 Vite dist 目录后，由后端直接托管 SPA
SERVE_FRONTEND_DIR=
