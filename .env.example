# Personal Second Brain - Environment Configuration

# Application
ENV=development
APP_NAME=Personal Second Brain

# Database
DATABASE_URL=sqlite:///./psb.db
# 生产环境必须设置；开发环境留空则关闭数据库加密。
DATABASE_ENCRYPT_KEY=

# Security (生产环境必须设置强随机密钥!)
# 开发环境留空会自动生成临时密钥，但生产环境启动会失败。
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Admin (生产环境必须设置强随机密钥!)
ADMIN_SECRET_KEY=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis
REDIS_URL=redis://localhost:6379/0

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_FALLBACK_MODEL=qwen2.5

# Model routing configs
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS_DEFAULT=2048
MAX_TOKENS_LONG=8192

# API Keys (optional, for cloud providers)
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENCODE_API_KEY=

# Embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMADB_PERSIST_DIR=./chroma_db
EMBEDDING_DIMENSION=768

# URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Object storage (S3-compatible, default points to local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=psbminio
S3_SECRET_KEY=psbminio-secret
S3_BUCKET=psb-sync
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment - Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# Payment - WeChat
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_API_KEY=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY=

# Payment - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
