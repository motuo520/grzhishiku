APP_NAME=Personal Second Brain
DEBUG=True

DATABASE_URL=sqlite:///./psb.db
# 生产环境必须设置强密钥；开发环境留空则关闭数据库加密。
DATABASE_ENCRYPT_KEY=

# 安全密钥：生产环境必须设置强随机密钥；开发环境留空会自动生成临时密钥。
SECRET_KEY=
ADMIN_SECRET_KEY=

REDIS_URL=redis://localhost:6379/0

OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# 对象存储（S3 兼容，本地开发默认指向 MinIO）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=psbminio
S3_SECRET_KEY=psbminio-secret
S3_BUCKET=psb-sync
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true
