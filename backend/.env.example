# Personal Second Brain Backend（开源精简版）
# 说明：docker compose 已内置全部默认值，无需复制本文件。
# 仅在本地开发（uvicorn 直跑）时：cp .env.example .env

APP_NAME=Personal Second Brain
DEBUG=True

DATABASE_URL=sqlite:///./psb.db
# 生产环境必须设置强密钥；开发环境留空则关闭数据库加密。
DATABASE_ENCRYPT_KEY=

# 安全密钥：生产环境必须设置强随机密钥；开发环境留空会自动生成临时密钥。
SECRET_KEY=
ADMIN_SECRET_KEY=

# 本地模型（Ollama，开源版仅支持本地模型）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
# 图谱构建（graphify）专用模型，空则回退 OLLAMA_MODEL；
# 0.5B 模型无法稳定输出提取 JSON，想用好图谱建议 qwen2.5:3b 或 qwen2.5-coder:7b（需先 ollama pull）
GRAPHIFY_OLLAMA_MODEL=

# 对象存储（S3 兼容，本地开发默认指向 MinIO）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=psbminio
S3_SECRET_KEY=psbminio-secret
S3_BUCKET=psb-sync
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true
