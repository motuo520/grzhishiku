{
  "id": "readwise-sync",
  "name": "Readwise 同步",
  "version": "1.0.0",
  "description": "同步 Readwise 高亮与书摘到知识库，支持增量同步。",
  "type": "builtin",
  "entrypoint": "plugin:ReadwiseSyncPlugin",
  "enabled_default": false,
  "permissions": [
    "network.outbound",
    "storage.write"
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "api_token"
    ],
    "properties": {
      "api_token": {
        "type": "string",
        "title": "Readwise API Token",
        "description": "从 https://readwise.io/access_token 获取"
      },
      "brain_side": {
        "type": "string",
        "enum": [
          "personal",
          "network"
        ],
        "default": "network",
        "title": "默认脑侧"
      },
      "last_sync_at": {
        "type": "string",
        "title": "上次同步时间",
        "description": "ISO 格式，由系统自动更新"
      },
      "auto_sync": {
        "type": "object",
        "title": "自动同步",
        "description": "按设定间隔自动同步 Readwise 高亮",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "title": "启用自动同步"
          },
          "interval_minutes": {
            "type": "integer",
            "enum": [
              30,
              60,
              360,
              1440
            ],
            "default": 60,
            "title": "同步间隔"
          },
          "last_sync_error": {
            "type": "string",
            "title": "上次同步错误"
          }
        }
      }
    }
  }
}
